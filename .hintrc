{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "details[name]",
          "template[shadowrootmode]"
        ]
      }
    ],
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "color: light-dark(black, white)",
          "@starting-style",
          "backdrop-filter"
        ]
      }
    ]
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not and_ff <= 139",
    "not chrome <= 109",
    "not firefox <= 139",
    "not ios_saf <= 16.7",
    "not samsung <= 28"
  ]
}